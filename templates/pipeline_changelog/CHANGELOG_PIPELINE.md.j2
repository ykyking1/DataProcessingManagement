{# Pipeline-specific changelog rendered by Python Semantic Release. -#}
{%- macro render_commit(commit) -%}
{% if commit.error is undefined -%}
{% set description = commit.descriptions[0] | safe -%}
- {% if commit.scope %}**{{ commit.scope }}**: {% endif %}{{ (description[0] | upper) ~ description[1:] }} ([`{{ commit.short_hash }}`]({{ commit.hexsha | commit_hash_url }}))
{% else -%}
- {{ (commit.commit.message | string).split("\n", maxsplit=1)[0] }}
{% endif -%}
{%- endmacro %}

{%- macro render_changes(elements) -%}
{% for type_, commits in elements | dictsort if type_ != "unknown" -%}
{% if commits | length > 0 %}
### {{ type_ | title }}

{% for commit in commits -%}
{{ render_commit(commit) }}
{% endfor %}
{% endif -%}
{% endfor -%}
{%- endmacro %}

{%- macro render_release(release) -%}
## {{ release.version.as_tag() }} ({{ release.tagged_date.strftime("%Y-%m-%d") }})

{{ render_changes(release["elements"]) }}
{%- endmacro %}

{%- set insertion_flag = ctx.changelog_insertion_flag -%}
{%- set releases = ctx.history.released.values() | list -%}
{%- set unreleased = ctx.history.unreleased | dictsort -%}
{% if ctx.changelog_mode == "update" -%}
{% set previous = ctx.prev_changelog_file | read_file | safe -%}
{% set parts = previous.split(insertion_flag, maxsplit=1) -%}
{% if parts | length == 2 -%}
{{ parts[0] | trim }}

{{ insertion_flag }}
{% if unreleased | length > 0 %}
## Unreleased

{% for type_, commits in unreleased if type_ != "unknown" -%}
{% if commits | length > 0 %}
### {{ type_ | title }}

{% for commit in commits -%}
{{ render_commit(commit) }}
{% endfor %}
{% endif -%}
{% endfor -%}
{% endif -%}
{% if releases | length > 0 -%}
{% set latest = releases[0] -%}
{% if latest.version.as_tag() not in parts[1] %}
{{ render_release(latest) }}

{% endif -%}
{% endif -%}
{{ parts[1] | trim }}
{% else -%}
# Pipeline Changelog

Dagster orchestration, processing, validation, reproducibility, and runtime dependency changes are recorded here.

{{ insertion_flag }}

{% for release in releases -%}
{{ render_release(release) }}

{% endfor -%}
{% endif -%}
{% else -%}
# Pipeline Changelog

Dagster orchestration, processing, validation, reproducibility, and runtime dependency changes are recorded here.

{% if ctx.changelog_mode == "update" -%}
{{ insertion_flag }}

{% endif -%}
{% if unreleased | length > 0 -%}
## Unreleased

{% for type_, commits in unreleased if type_ != "unknown" -%}
{% if commits | length > 0 %}
### {{ type_ | title }}

{% for commit in commits -%}
{{ render_commit(commit) }}
{% endfor %}
{% endif -%}
{% endfor -%}
{% endif -%}
{% for release in releases -%}
{{ render_release(release) }}

{% endfor -%}
{% endif -%}

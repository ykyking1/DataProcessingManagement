<clickhouse>
    <profiles>
        <default>
            <!--
              Tek bir sorgunun tüketebileceği bellek tavanı. Loader
              (scripts/load_validated_auair_to_clickhouse.py) bu ayarı ezmiyor,
              dolayısıyla geniş INSERT ... SELECT FROM s3() sorguları bu sınıra
              takılırsa sunucuyu çökertmeden "Code: 241" ile durur.

              GROUP BY / JOIN gibi ağır adımlar bellek yerine diske taşabilsin
              diye external limitler de tanımlı.
            -->
            <max_memory_usage>3500000000</max_memory_usage>
            <max_bytes_before_external_group_by>2000000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>2000000000</max_bytes_before_external_sort>
        </default>
    </profiles>
</clickhouse>
